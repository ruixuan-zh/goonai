# Copy this file to .env only for live Bedrock mode. Replay mode needs no .env.
# Choose ONE authentication method: AWS profile, temporary credentials, or a
# Bedrock API key. Keep every real credential out of source control.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# Amazon Bedrock model and safety/cost controls
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
BIO_SIGNAL_MAX_MODEL_CALLS=4
BIO_SIGNAL_MAX_TOOL_CALLS=6
BIO_SIGNAL_MAX_OUTPUT_TOKENS=300
# Per-investigation application guard, not an AWS account-wide spending cap.
BIO_SIGNAL_SESSION_BUDGET_USD=1.00
BIO_SIGNAL_FALLBACK_TO_REPLAY=true
